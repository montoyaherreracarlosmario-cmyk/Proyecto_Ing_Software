# Copia este archivo como .env (NO se sube a git)
# Misma base de datos que usa el backend NestJS
MONGODB_URI="mongodb+srv://USUARIO:CLAVE@TU-CLUSTER.mongodb.net/habitat-capital?retryWrites=true&w=majority"
# Puerto de esta API (el backend Nest usa 4000, el frontend 3000)
PORT=4100
# URL(s) del frontend permitidas por CORS, separadas por coma
FRONTEND_URL=http://localhost:3000
# Carpeta destino de las imágenes subidas
UPLOAD_DIR=uploads/imagenes
# Tamaño máximo de imagen de FIRMA aceptado (bytes, base64 decodificado)
MAX_FIRMA_BYTES=1000000
# Tamaño máximo de imagen genérica subida (bytes)
MAX_IMAGEN_BYTES=10485760
